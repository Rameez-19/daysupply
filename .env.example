# Copy to .env for local development. Read by load_dotenv() in app/main.py.
# Cloud Run does not use this file; env vars set on the service always win.

# --- Google Cloud -----------------------------------------------------------
GCP_PROJECT=daysupply

# --- Gemini -----------------------------------------------------------------
# Gemini is called through Vertex AI with your Google Cloud credentials
# (gcloud auth application-default login). No API key is needed.
# The model chain is in prompts/models.json; these override it.
# GEMINI_MODEL=gemini-3.8-flash@global
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash@global,gemini-3.6-flash@global,gemini-3.5-flash@asia-south1,gemini-2.5-flash@asia-south1
# GEMINI_TIMEOUT_MS=25000

# For local experiments with a Google AI Studio key instead:
# GEMINI_BACKEND=apikey
# GEMINI_API_KEY=your-ai-studio-key
