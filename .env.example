# Copy to .env for local development. Read by load_dotenv() in app/main.py,
# which runs before any app.* import because those modules read os.getenv at
# import time.
#
# Cloud Run does not use this file. It injects env vars into the container
# directly, load_dotenv() finds nothing, and nothing is overridden — an env var
# already present in the environment always wins over a value in .env.

# --- Gemini -----------------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
#
# KEY FORMAT: current AI Studio keys begin with `AQ.` — the Auth key format
# Google migrated to in June 2026. The older `AIza` Standard keys are being
# rejected outright from September 2026, so a key of that shape is not worth
# debugging; issue a new one.
GEMINI_API_KEY=AQ.your-ai-studio-key-here

# --- Google Cloud -----------------------------------------------------------
GCP_PROJECT=daysupply
